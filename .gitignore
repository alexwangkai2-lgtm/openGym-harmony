# Exercise media downloaded by installs before v1.4.0 (now in catalogue/media); kept ignored so an
# old folder never gets committed by accident
media/img/
media/gif/

# Exercise stills and animations themselves — 263 MB across 13k files, and licensed from Gym
# visual for openGym rather than redistributable from this fork. catalogue/media/NOTICE.md is
# kept so the attribution travels with the code; run the project's own staging step (or point
# APP_MEDIA_DIR at a copy) to get the files back.
catalogue/media/still/
catalogue/media/clip/

# Runtime data — users, passkeys, per-user state, session secret
data/

# Local config
.env

# Build output / deps
frontend/dist/
frontend/dist-harmony/
node_modules/
*.log
.DS_Store
node_modules
.claude/
.agents/
.superpowers/

# Nix build result symlinks
result
result-*

# CI reports (test:* jobs write these next to the suites)
junit.xml
coverage/
frontend/bundle-size.json

# Local planning notes
docs/superpowers/plans/

# HarmonyOS shell. The web bundle inside the HAP is build output (harmony/scripts/sync-web.mjs
# replaces it wholesale) and the signing material is DevEco's to write; neither belongs in a commit.
harmony/entry/src/main/resources/rawfile/www/
harmony/build/
harmony/entry/build/
harmony/.hvigor/
harmony/oh_modules/
harmony/entry/oh_modules/
harmony/oh-package-lock.json5
harmony/.clangd
harmony/.clang-format
harmony/.clang-tidy
harmony/local.properties
harmony/signature/
harmony/.idea/

# Local devecocli / emulator verification artefacts (not part of the app)
harmony/*log*.txt
harmony/code-linter.json5
.workbuddy/

# Upstream 1.4.4 additions
test-results.json
test-results.jsonl
lcov.info
/stats/
# Python and Kotlin build leftovers (scripts/, the Android build)
__pycache__/
*.pyc
.kotlin/
# The maintainer's brand material (logo variants, merch, Buy Me a Coffee covers) sits next to the
# tracked banner and screenshots but is not part of the repository; keep it out of a `git add -A`
assets/logo/
assets/merch/
assets/tee/
assets/bmc-cover*
# scripts/pdf/render-samples.mjs output (npm run pdf:check)
frontend/pdf-samples/
